# Optional fallback API key for ESPHome devices.
# Prefer entering per-device keys in the application UI.
ESP_API_KEY=

# SQLite database location inside the container
DB_PATH=/data/pixelanim.db

# ESPHome service names (change only if your firmware uses different names)
STREAM_SERVICE=mostra_frame
COLOR_SERVICE=mostra_frame_colore
STOP_SERVICE=ferma_stream
COLOR_LOAD_SERVICE=carica_animazione_colore

# Firmware animation buffers (bytes)
MONO_MAX_BYTES=2048
COLOR_MAX_BYTES=8192
